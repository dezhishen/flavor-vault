{
  "id": "zi-ran-tu-dou-niu-rou",
  "name": "孜然土豆牛肉",
  "description": "土豆丁小火煎至两面金黄，牛肉粒大火快炒锁住汁水，再用孜然和辣椒面激发香味，撒上熟芝麻和葱花，香辣下饭。",
  "stats": {
    "prep_time": 5,
    "cook_time": 15,
    "difficulty": 2
  },
  "created_at": "0001-01-01T00:00:00Z",
  "updated_at": "0001-01-01T00:00:00Z",
  "tags": [
    "热菜",
    "下饭"
  ],
  "kitchenware": [
    "炒锅"
  ],
  "ingredients": {
    "main": [
      {
        "name": "牛肉",
        "amount": "300g（选嫩部位，切骰子大小）"
      },
      {
        "name": "土豆",
        "amount": "1个（削皮切骰子大小）"
      }
    ],
    "side": [
      {
        "name": "大蒜",
        "amount": "4瓣"
      },
      {
        "name": "小葱",
        "amount": "2-4根（切末）"
      }
    ]
  },
  "seasonings": [
    {
      "name": "孜然",
      "amount": "2勺"
    },
    {
      "name": "辣椒面",
      "amount": "2勺",
      "note": "推荐六婆辣椒面"
    },
    {
      "name": "熟芝麻",
      "amount": "1把"
    },
    {
      "name": "生抽",
      "amount": "1勺（腌牛肉用）"
    },
    {
      "name": "老抽",
      "amount": "半勺（腌牛肉用）"
    },
    {
      "name": "蚝油",
      "amount": "半勺（腌牛肉用）"
    },
    {
      "name": "盐",
      "amount": "少许（腌牛肉用）"
    },
    {
      "name": "食用油",
      "amount": "适量"
    }
  ],
  "steps": [
    {
      "order": 1,
      "description": "备菜：土豆削皮切骰子大小；牛肉切骰子大小，加1勺生抽、半勺老抽、半勺蚝油、少许盐抓匀，再用油抓一下腌制；大蒜子4瓣、小葱2-4根切末"
    },
    {
      "order": 2,
      "description": "锅烧热，调最小火，加油（稍多一点），倒入土豆丁，煎至两面金黄，盛出土豆"
    },
    {
      "order": 3,
      "description": "就锅里面剩的油，开大火把油烧热，下牛肉粒大火翻炒三十秒左右，炒到变色，把牛肉盛出"
    },
    {
      "order": 4,
      "description": "重新起锅（需要洗锅），将锅烧热，加入适量油（比平常炒菜少一点），将葱蒜爆香（剩一把葱花），倒入牛肉和土豆，翻炒几下，加入辣椒面和孜然，翻炒几下，加入一把熟芝麻，炒出香味以后，撒上剩下的葱花出锅"
    }
  ],
