          {
            "name": "鸡蛋",
            "amount": "1个"
          },
          {
            "name": "蟹味菇",
            "amount": "1盒"
          },
          {
            "name": "西红柿",
            "amount": "1大个或2小个"
          },
          {
            "name": "甜玉米",
            "amount": "1根"
          },
          {
            "name": "香菜",
            "amount": "取香菜叶适量"
          },
          {
            "name": "开水",
            "amount": "一壶"
          }
        ],
        "side": [
          {
            "name": "食用油",
            "amount": "平常煎蛋的1.5-2倍"
          },
          {
            "name": "生抽",
            "amount": "1~2勺（炒料激发香味）+ 出锅前调味"
          },
          {
            "name": "食盐",
            "amount": "先加1~2勺，汤开后调味"
          },
          {
            "name": "白胡椒粉",
            "amount": "适量"
          },
          {
            "name": "可选食材",
            "amount": "豆腐、娃娃菜等（味道重的菜不行）"
          }
        ]
      },
      "seasonings": [],
      "steps": [
        {
          "order": 1,
          "description": "备菜：蟹味菇去根洗净，西红柿切丁，甜玉米切小块；其他食材切成差不多大小，煮不软的最多食指长度，叶子菜保证一筷子好夹；香菜摘好叶子",
          "image_ref": "images/素菜高汤-1-1.svg"
        },
        {
          "order": 2,
          "description": "热锅冷油，油量为平常煎蛋的1.5-2倍，煎一个荷包蛋，盛出备用"
        },
        {
          "order": 3,
          "description": "不用洗锅，倒入西红柿丁，炒出沙（汤底味道的关键）"
        },
        {
          "order": 4,
          "description": "倒入蟹味菇，与番茄裹均匀后，加入1~2勺生抽，把生抽香味激发出来，再把煎蛋倒进去搅拌均匀"
        },
        {
          "order": 5,
          "description": "加入其他食材，立即加入开水（白汤关键），保证水没过食材，先加1~2勺食盐，汤开后再调味"
        },
        {
          "order": 6,
          "description": "汤开后（食材难熟可小火再炖，一般素菜不会难熟），加入白胡椒粉、生抽、食盐按个人口味调味，最后撒入香菜，关火即可"
        }
      ],
