  "versions": [
    {
      "name": "",
      "ingredients": {
        "main": [
          {
            "name": "虾",
            "amount": "400-500g（约20只）"
          },
          {
            "name": "紫苏",
            "amount": "1把（约20-30片叶，切沫）"
          }
        ],
        "side": [
          {
            "name": "姜",
            "amount": "1小块（切末）"
          },
          {
            "name": "蒜",
            "amount": "4-5瓣（切末）"
          },
          {
            "name": "小米辣",
            "amount": "3-5个（切圈）"
          },
          {
            "name": "生抽",
            "amount": "1.5-2勺"
          },
          {
            "name": "蚝油",
            "amount": "1勺"
          },
          {
            "name": "油",
            "amount": "适量"
          },
          {
            "name": "盐",
            "amount": "少量"
          }
        ]
      },
      "steps": [
        {
          "order": 1,
          "description": "备菜：虾去头、去脚，用剪刀剪成小段；虾头单独保留；姜蒜切末，小米辣切圈，紫苏取叶切沫",
          "image_ref": "images/chao-jue-zi-su-xia/超绝紫苏虾-1-1.jpg"
        },
        {
          "order": 2,
          "description": "虾单独下锅炒至半熟，盛出备用",
          "image_ref": "images/chao-jue-zi-su-xia/超绝紫苏虾-2-1.jpg"
        },
        {
          "order": 3,
          "description": "虾头用小火煎出虾油，用筷子夹出虾头，丢弃",
          "image_ref": "images/chao-jue-zi-su-xia/超绝紫苏虾-3-1.jpg"
        },
        {
          "order": 4,
          "description": "在虾油中再加少许油，姜蒜小米辣爆香",
          "image_ref": "images/chao-jue-zi-su-xia/超绝紫苏虾-4-1.jpg"
        },
        {
          "order": 5,
          "description": "倒入半熟的虾一起翻炒",
          "image_ref": "images/chao-jue-zi-su-xia/超绝紫苏虾-5-1.jpg"
        },
        {
          "order": 6,
          "description": "加生抽、蚝油、油、盐调味，出锅前3分钟放入紫苏沫，炒到紫苏叶都软趴趴、入味即可出锅",
          "image_ref": "images/chao-jue-zi-su-xia/超绝紫苏虾-6-1.jpg"
        }
      ],
