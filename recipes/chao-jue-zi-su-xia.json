  "steps": [
    {
      "order": 1,
      "description": "备菜：虾去头、去脚，用剪刀剪成小段；姜蒜切末，小米辣切圈，紫苏取叶切沫"
    },
    {
      "order": 2,
      "description": "虾单独下锅炒至半熟，盛出备用"
    },
    {
      "order": 3,
      "description": "另起锅，姜蒜小米辣炒香"
    },
    {
      "order": 4,
      "description": "倒入半熟的虾一起翻炒"
    },
    {
      "order": 5,
      "description": "加生抽、蚝油、油、盐调味，出锅前3分钟放入紫苏沫，炒到紫苏叶都软趴趴、入味即可出锅"
    }
