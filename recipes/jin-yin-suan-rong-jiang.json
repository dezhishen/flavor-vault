      "steps": [
        {
          "order": 1,
          "description": "备菜：香菜、小葱、大葱切段，洋葱切丝"
        },
        {
          "order": 2,
          "description": "备菜：蒜切末，以1/3、2/3的比例分为两份"
        },
        {
          "order": 3,
          "description": "备菜：将2/3的蒜转入漏网或卤料等容具，清洗至水体较清、不黏手，沥干水分，清洗过程中留小半碗蒜水"
        },
        {
          "order": 4,
          "description": "炒制：起锅大火烧油，加入香菜、小葱、大葱、洋葱，炸至焦黄后捞出"
        },
        {
          "order": 5,
          "description": "炒制：加入2/3蒜末，炸至略微发黄发焦后，加入1/3生蒜翻匀，加入蒜水"
        },
        {
          "order": 6,
          "description": "炒制：蒜水蒸发、熟蒜基本发黄后关火，加入一勺蚝油、一勺鸡精/鸡汁、两勺盐、一勺糖翻拌均匀"
        },
        {
          "order": 7,
          "description": "炒制：盛出盖盖焖凉"
        }
      ],
